<?xml version="1.0" encoding="UTF-8"?>
<roles jcr:primaryType="jnt:permission"
             xmlns:jcr="http://www.jcp.org/jcr/1.0"
             xmlns:j="http://www.jahia.org/jahia/1.0"
             xmlns:jnt="http://www.jahia.org/jahia/nt/1.0">
    <store-administrator j:hidden="false"
           j:permissionNames="jahiaForgeModerateModule jahiaForgeUploadModule jcr:all_live jcr:all_default"
           j:privilegedAccess="true"
           j:roleGroup="site-role"
           jcr:primaryType="jnt:role">
        <j:translation_en jcr:description=""
                          jcr:language="en"
                          jcr:primaryType="jnt:translation"
                          jcr:title="Private App Store administrator"/>
        <categories-access j:path="/sites/systemsite/categories"
                        j:permissionNames="jcr:all_default"
                        jcr:primaryType="jnt:externalPermissions"/>
    </store-administrator>

    <!-- SEC-366 / GHSA-f882-3xwv-3439: this role must NOT carry any *_live ACL permission.
         jcr:modifyAccessControl_live at site scope let anyone allowed to upload a module rewrite
         the site's live ACL - self-promote to store-administrator (gaining jahiaForgeModerateModule,
         the gate on publishing a module to the store) and strip g:site-administrators - with no
         publication step to make it reviewable. It was only ever here so that the upload could
         grant the uploader the owner role on its own new nodes; that grant now runs in a system
         session (OwnerRoleGrants), so nothing in the feature needs live ACL authority. -->
    <store-developer j:hidden="false"
                         j:permissionNames="jahiaForgeUploadModule jcr:write_live"
                         j:privilegedAccess="true"
                         j:roleGroup="site-role"
                         jcr:primaryType="jnt:role">
        <j:translation_en jcr:description=""
                          jcr:language="en"
                          jcr:primaryType="jnt:translation"
                          jcr:title="Private App Store developer"/>
    </store-developer>

</roles>
